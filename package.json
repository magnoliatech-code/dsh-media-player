{
  "name": "dsh-media-player",
  "version": "0.2.0",
  "private": true,
  "description": "Loopback video/audio player for the DSH Web panel: Range streaming for large renders, plus a Sidebar preview renderer so clicking a media file plays it",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./server": "./server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-media-player": "bin/media-player.js"
  },
  "files": [
    "index.js",
    "server.js",
    "player.html",
    "lib/client.js",
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magnoliatech-code/dsh-media-player.git"
  },
  "homepage": "https://github.com/magnoliatech-code/dsh-media-player#readme",
  "bugs": {
    "url": "https://github.com/magnoliatech-code/dsh-media-player/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "media-player",
    "video",
    "audio",
    "range"
  ]
}
